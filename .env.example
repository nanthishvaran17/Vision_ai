# VisionNext AI Environment Configuration
DATABASE_URL=sqlite+aiosqlite:///./visionnext.db
JWT_SECRET=super-secret-visionnext-jwt-key-2026-codienych-secure
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

LLM_PROVIDER=openai # openai | ollama
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=mock-key-for-local-fallback
VISION_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o

OCR_PROVIDER=easyocr # easyocr | paddle | tesseract | opencv
STORAGE_PROVIDER=local # local | s3
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

MAX_IMAGE_SIZE_MB=10
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_LOW=0.45
